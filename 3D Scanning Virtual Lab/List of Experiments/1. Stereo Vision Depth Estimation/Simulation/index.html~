<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Exp 1 — Stereo Vision Depth Estimation</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="style.css" />
</head>
<body>

  <!-- ╔══════════════════ HEADER ══════════════════╗ -->
  <header id="app-header">
    <div class="header-left">
      <span class="lab-badge">3D Scanning Virtual Lab</span>
      <h1>Experiment 1 &mdash; Stereo Vision Depth Estimation</h1>
    </div>
    <div class="step-bar" id="step-bar">
      <div class="step-node active" data-step="0">Intro</div>
      <div class="step-line"></div>
      <div class="step-node" data-step="1">Baseline</div>
      <div class="step-line"></div>
      <div class="step-node" data-step="2">Focal</div>
      <div class="step-line"></div>
      <div class="step-node" data-step="3">Distance</div>
      <div class="step-line"></div>
      <div class="step-node" data-step="4">Noise</div>
      <div class="step-line"></div>
      <div class="step-node" data-step="5">Explore</div>
    </div>
  </header>

  <!-- ╔══════════════════ MAIN LAYOUT ══════════════════╗ -->
  <main id="app-main">

    <!-- ── LEFT: WIZARD PANEL ── -->
    <aside id="wizard-panel">
      <div id="wizard-icon">📷</div>
      <h2 id="wizard-title">Welcome</h2>
      <p id="wizard-text"></p>
      <div id="wizard-task" class="task-box"></div>

      <div class="wizard-btns">
        <button id="btn-next" class="btn-primary">Next Step →</button>
        <button id="btn-skip" class="btn-ghost">Skip to Simulation</button>
      </div>

      <div class="legend-box" id="legend-box">
        <div class="legend-title">Depth Map Key</div>
        <div class="legend-row">
          <span class="legend-swatch near"></span>
          <span>Near object</span>
        </div>
        <div class="legend-row">
          <span class="legend-swatch far"></span>
          <span>Far / background</span>
        </div>
        <div class="legend-row">
          <span class="legend-swatch invalid"></span>
          <span>Invalid (d &lt; 1 px)</span>
        </div>
        <div class="legend-title" style="margin-top:8px">Uncertainty Map Key</div>
        <div class="legend-row">
          <span class="legend-swatch reliable"></span>
          <span>Reliable depth</span>
        </div>
        <div class="legend-row">
          <span class="legend-swatch unreliable"></span>
          <span>Unreliable depth</span>
        </div>
      </div>
    </aside>

    <!-- ── CENTER: CANVAS AREA ── -->
    <section id="canvas-area">

      <!-- Row 1: Scene overview + Camera views -->
      <div class="canvas-row" id="row-top">

        <div class="canvas-card" id="card-scene">
          <div class="card-header">
            <span class="card-title">&#x1F4D0; Scene — Top View</span>
            <span class="card-sub">Cameras looking down the Z-axis</span>
          </div>
          <canvas id="cvs-scene" width="340" height="178"></canvas>
        </div>

        <div class="canvas-card" id="card-cameras">
          <div class="card-header">
            <span class="card-title">&#x1F441; Camera Views</span>
            <span class="card-sub">Disparity bracket shown in gold</span>
          </div>
          <div class="dual-cam">
            <div class="cam-wrap">
              <div class="cam-label left-label">Left Camera</div>
              <canvas id="cvs-left" width="188" height="140"></canvas>
            </div>
            <div class="cam-wrap">
              <div class="cam-label right-label">Right Camera</div>
              <canvas id="cvs-right" width="188" height="140"></canvas>
            </div>
          </div>
        </div>

      </div>

      <!-- Row 2: Depth map + Uncertainty map -->
      <div class="canvas-row" id="row-bottom">

        <div class="canvas-card" id="card-depth">
          <div class="card-header">
            <span class="card-title">&#x1F3A8; Depth Map</span>
            <span class="card-sub">Red = near &nbsp;&bull;&nbsp; Blue = far &nbsp;&bull;&nbsp; Black = invalid</span>
          </div>
          <canvas id="cvs-depth" width="300" height="172"></canvas>
          <div class="colorbar-row">
            <span class="cb-label">0 m</span>
            <div class="colorbar depth-bar"></div>
            <span class="cb-label">10 m</span>
          </div>
        </div>

        <div class="canvas-card" id="card-unc">
          <div class="card-header">
            <span class="card-title">&#x26A0;&#xFE0F; Uncertainty Map</span>
            <span class="card-sub">Green = reliable &nbsp;&bull;&nbsp; Red = unreliable</span>
          </div>
          <canvas id="cvs-unc" width="300" height="172"></canvas>
          <div class="colorbar-row">
            <span class="cb-label">Low &Delta;Z</span>
            <div class="colorbar unc-bar"></div>
            <span class="cb-label">High &Delta;Z</span>
          </div>
        </div>

      </div>
    </section>

    <!-- ── RIGHT: CONTROLS ── -->
    <aside id="controls-panel">

      <h3 class="panel-heading">&#x2699;&#xFE0F; Parameters</h3>

      <!-- Baseline -->
      <div class="ctrl-group" id="grp-baseline">
        <div class="ctrl-top">
          <span class="ctrl-name">Baseline <em>B</em></span>
          <span class="ctrl-val" id="lbl-B">10 cm</span>
        </div>
        <input type="range" id="rng-B" min="2" max="50" step="0.5" value="10" />
        <div class="ctrl-range-row">
          <span>2 cm</span><span>50 cm</span>
        </div>
        <p class="ctrl-hint">Wider = better accuracy at distance; larger blind zone at edges</p>
      </div>

      <!-- Focal Length -->
      <div class="ctrl-group" id="grp-focal">
        <div class="ctrl-top">
          <span class="ctrl-name">Focal Length <em>f</em></span>
          <span class="ctrl-val" id="lbl-f">700 px</span>
        </div>
        <input type="range" id="rng-f" min="200" max="1000" step="10" value="700" />
        <div class="ctrl-range-row">
          <span>200 px</span><span>1000 px</span>
        </div>
        <p class="ctrl-hint">Higher f = better precision but narrower field of view</p>
      </div>

      <!-- Object Distance -->
      <div class="ctrl-group" id="grp-Z">
        <div class="ctrl-top">
          <span class="ctrl-name">Object Distance <em>Z</em></span>
          <span class="ctrl-val" id="lbl-Z">2.00 m</span>
        </div>
        <input type="range" id="rng-Z" min="0.3" max="10" step="0.05" value="2" />
        <div class="ctrl-range-row">
          <span>0.3 m</span><span>10 m</span>
        </div>
        <p class="ctrl-hint">Moves the object closer or farther from the camera pair</p>
      </div>

      <!-- Noise -->
      <div class="ctrl-group" id="grp-noise">
        <div class="ctrl-top">
          <span class="ctrl-name">Disparity Noise <em>&sigma;</em></span>
          <span class="ctrl-val" id="lbl-s">0.0 px</span>
        </div>
        <input type="range" id="rng-s" min="0" max="8" step="0.1" value="0" />
        <div class="ctrl-range-row">
          <span>0 px</span><span>8 px</span>
        </div>
        <p class="ctrl-hint">Gaussian noise on disparity — watch RMSE grow with distance</p>
      </div>

      <div class="divider"></div>

      <!-- Live Readouts -->
      <h3 class="panel-heading">&#x1F4CA; Live Readouts</h3>
      <div class="readout-grid">
        <div class="readout-card" id="rc-d">
          <span class="rc-label">Disparity <em>d</em></span>
          <span class="rc-value" id="out-d">—</span>
          <span class="rc-unit">px</span>
        </div>
        <div class="readout-card">
          <span class="rc-label">Computed <em>Z</em></span>
          <span class="rc-value" id="out-Z">—</span>
          <span class="rc-unit">m</span>
        </div>
        <div class="readout-card" id="rc-dz">
          <span class="rc-label">Uncertainty <em>&Delta;Z</em></span>
          <span class="rc-value" id="out-dZ">—</span>
          <span class="rc-unit">cm</span>
        </div>
        <div class="readout-card" id="rc-rmse">
          <span class="rc-label">RMSE</span>
          <span class="rc-value" id="out-rmse">—</span>
          <span class="rc-unit">cm</span>
        </div>
      </div>

      <!-- Formula display -->
      <div class="formula-card">
        <div class="formula-line">
          <span class="f-eq">Z&nbsp;=&nbsp;(f &times; B)&nbsp;/&nbsp;d</span>
          <span class="f-live" id="f-Z">= &mdash;</span>
        </div>
        <div class="formula-line">
          <span class="f-eq">&Delta;Z&nbsp;=&nbsp;Z&sup2;&sigma;&nbsp;/&nbsp;(f&times;B)</span>
          <span class="f-live" id="f-dZ">= &mdash;</span>
        </div>
      </div>

      <button id="btn-reset" class="btn-reset">&#x21BA; Reset Defaults</button>

    </aside>

  </main>

  <script src="simulation.js"></script>
</body>
</html>
