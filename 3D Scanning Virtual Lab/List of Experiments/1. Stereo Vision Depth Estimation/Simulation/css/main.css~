* { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, sans-serif; }

body {
    background-color: #eef2f5; 
    color: #2c3e50;
    min-height: 100vh;
    padding: 20px;
    min-width: 1200px; 
    overflow-x: auto; 
}

.layout-container {
    display: flex;
    flex-direction: column;
    gap: 20px; 
    width: 100%;
    max-width: 1800px;
    margin: 0 auto;
}

.row {
    display: flex;
    flex-wrap: nowrap; 
    gap: 20px;
    width: 100%;
}

.top-row { height: 45vh; min-height: 400px; }
.bottom-row { height: 35vh; min-height: 300px; }
.w-65 { width: calc(65% - 10px); }
.w-35 { width: calc(35% - 10px); }
.w-40 { width: calc(40% - 13.33px); }
.w-30 { width: calc(30% - 13.33px); }

.app-header { 
    background: #ffffff; 
    padding: 20px 25px; 
    border-radius: 20px; 
    box-shadow: 0 0 10px rgba(0,0,0,0.1); 
}

.app-header h1 { 
    font-size: 1.5rem; 
    color: #2c3e50; 
    margin-bottom: 5px; 
}

.app-header p { 
    font-size: 1rem; 
    color: #7f8c8d; 
}

.card {
    background: #ffffff; 
    border-radius: 20px; 
    padding: 10px;
    box-shadow: 0 0 10px rgba(0,0,0,0.1); 
    display: flex; 
    flex-direction: column;
    height: 100%;
}

.card-title { 
    font-size: 0.95rem; 
    color: #7f8c8d; 
    text-transform: uppercase; 
    letter-spacing: 1px; 
    font-weight: 700; 
    margin: 5px 0 10px 10px; 
}

.canvas-container, .chart-container {
    flex-grow: 1; 
    position: relative; 
    width: 100%; 
    background: #f8f9fa;
    border-radius: 12px; 
    overflow: hidden; 
    min-height: 200px;
}

canvas { 
    position: absolute; 
    top: 0; 
    left: 0; 
    width: 100%; 
    height: 100%; 
    display: block; 
}

.metrics-content { display: flex; flex-direction: column; gap: 15px; padding: 10px; height: 100%; justify-content: center; }
.metric-item { display: flex; justify-content: space-between; align-items: center; background: #f0f4f8; padding: 15px 20px; border-radius: 12px; }
.metric-label { font-size: 1.1rem; font-weight: 600; color: #34495e; }
.metric-value { font-size: 1.8rem; font-weight: 700; color: #0056b3; font-variant-numeric: tabular-nums; }
.warning-box { background: #e74c3c; color: #fff; padding: 15px; border-radius: 12px; font-weight: bold; text-align: center; }
.hidden { display: none !important; }
.sliders-content { padding: 10px; display: flex; flex-direction: column; justify-content: space-around; height: 100%; }
.slider-group { margin-bottom: 10px; }
.slider-labels { display: flex; justify-content: space-between; margin-bottom: 8px; font-weight: 600; font-size: 0.95rem; }

input[type="range"] { 
    -webkit-appearance: none; 
    width: 100%; 
    height: 8px; 
    border-radius: 4px; 
    outline: none; 
    cursor: pointer; 
    background: #3498db; 
}

input[type="range"]::-webkit-slider-thumb { 
    -webkit-appearance: none; 
    appearance: none; 
    width: 20px; 
    height: 20px; 
    border-radius: 50%; 
    background: #fff; 
    border: 2px solid #2c3e50; 
    cursor: pointer; 
    box-shadow: 0 2px 5px rgba(0,0,0,0.2); 
}
