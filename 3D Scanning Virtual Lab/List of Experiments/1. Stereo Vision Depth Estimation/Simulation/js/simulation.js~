/* ================================================================
   STEREO VISION DEPTH ESTIMATION — SIMULATION LOGIC
   Experiment 1 | 3D Scanning Virtual Lab
   ================================================================ */

'use strict';

// Elements
const DOM = {
  b: document.getElementById('rng-B'), f: document.getElementById('rng-f'),
  z: document.getElementById('rng-Z'), s: document.getElementById('rng-s'),
  lblB: document.getElementById('lbl-B'), lblf: document.getElementById('lbl-f'),
  lblZ: document.getElementById('lbl-Z'), lbls: document.getElementById('lbl-s'),
  outD: document.getElementById('out-d'), outZ: document.getElementById('out-Z'),
  outDZ: document.getElementById('out-dZ'), outRMSE: document.getElementById('out-rmse'),
  fZ: document.getElementById('f-Z'), fDZ: document.getElementById('f-dZ'),
  appCanvas: document.getElementById('apparatusCanvas'),
  camCanvas: document.getElementById('cameraCanvas')
};

const ctxApp = DOM.appCanvas.getContext('2d');
const ctxCam = DOM.camCanvas.getContext('2d');
let errorChart;

// State Management
const S = { B: 0.10, f: 700, Z: 2.0, sigma: 0.0, step: 0 };

const calcDisparity = (f, B, Z) => (f * B) / Z;
const calcUncertainty = (Z, sigma, f, B) => (Math.pow(Z, 2) * sigma) / (f * B);

function initChart() {
    errorChart = new Chart(document.getElementById('errorChart').getContext('2d'), {
        type: 'line',
        data: { labels: [], datasets: [{ label: 'Error (cm)', data: [], borderColor: '#3b82f6', backgroundColor: 'rgba(59, 130, 246, 0.1)', borderWidth: 2, fill: true, pointRadius: 0 }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { title: { display: true, text: 'Distance (m)' } } } }
    });
}

function updateState() {
    // Read from Sliders (B is mapped 1 to 50 cm -> 0.01 to 0.50m)
    S.B = parseFloat(DOM.b.value) / 100; 
    S.f = parseFloat(DOM.f.value);
    S.Z = parseFloat(DOM.z.value);
    S.sigma = parseFloat(DOM.s.value);

    // Update Labels
    DOM.lblB.textContent = (S.B * 100).toFixed(1) + ' cm';
    DOM.lblf.textContent = S.f + ' px';
    DOM.lblZ.textContent = S.Z.toFixed(2) + ' m';
    DOM.lbls.textContent = S.sigma.toFixed(1) + ' px';

    // Math
    const d = calcDisparity(S.f, S.B, S.Z);
    const dZ = calcUncertainty(S.Z, S.sigma, S.f, S.B);

    // Readouts
    DOM.outD.textContent = d.toFixed(1);
    DOM.outZ.textContent = S.Z.toFixed(2);
    DOM.outDZ.textContent = '±' + (dZ * 100).toFixed(2);
    DOM.outRMSE.textContent = (dZ * 100).toFixed(2); // Simplified RMSE approx for view

    // Formulas
    DOM.fZ.innerHTML = `= ${S.Z.toFixed(2)}m`;
    DOM.fDZ.innerHTML = `= &plusmn;${(dZ * 100).toFixed(2)}cm`;

    // Chart Update
    const dists = [], uncerts = [];
    for (let dist = 0.5; dist <= 15; dist += 0.5) { 
        dists.push(dist.toFixed(1)); 
        uncerts.push((calcUncertainty(dist, S.sigma, S.f, S.B) * 100).toFixed(2)); 
    }
    errorChart.data.labels = dists; 
    errorChart.data.datasets[0].data = uncerts; 
    errorChart.update();
}

function resizeCanvases() {
    [DOM.appCanvas, DOM.camCanvas].forEach(canvas => {
        const rect = canvas.parentElement.getBoundingClientRect();
        const dpr = window.devicePixelRatio || 1;
        canvas.width = rect.width * dpr; canvas.height = rect.height * dpr;
        canvas.style.width = `${rect.width}px`; canvas.style.height = `${rect.height}px`;
        canvas.getContext('2d').scale(dpr, dpr);
    });
}

function drawApparatus(w, h, time) {
    ctxApp.clearRect(0, 0, w, h);
    const cx = w / 2, groundY = h - 40, scaleX = (w * 0.4) / 0.50, scaleY = (h * 0.6) / 15.0; 
    const camLeftX = cx - (S.B / 2) * scaleX, camRightX = cx + (S.B / 2) * scaleX;
    const objectX = cx, objectY = groundY - (S.Z * scaleY);

    ctxApp.beginPath(); ctxApp.setLineDash([6, 6]); ctxApp.lineDashOffset = -time / 20;
    ctxApp.moveTo(camLeftX, groundY); ctxApp.lineTo(objectX, objectY);
    ctxApp.moveTo(camRightX, groundY); ctxApp.lineTo(objectX, objectY);
    ctxApp.strokeStyle = '#3b82f6'; ctxApp.lineWidth = 2; ctxApp.stroke(); ctxApp.setLineDash([]);

    ctxApp.fillStyle = '#10b981'; ctxApp.beginPath(); ctxApp.arc(objectX, objectY, 10, 0, Math.PI*2); ctxApp.fill();
    ctxApp.fillStyle = '#0f172a'; ctxApp.fillRect(camLeftX - 15, groundY - 10, 30, 20); ctxApp.fillRect(camRightX - 15, groundY - 10, 30, 20);
}

function drawCameraPOV(w, h, d) {
    ctxCam.clearRect(0, 0, w, h);
    const halfW = w / 2, centerY = h / 2;
    ctxCam.fillStyle = '#0f172a'; ctxCam.fillRect(0, 0, halfW - 2, h); ctxCam.fillRect(halfW + 2, 0, halfW - 2, h);
    
    ctxCam.fillStyle = '#fff'; ctxCam.font = '10px Inter';
    ctxCam.fillText("LEFT SENSOR", 10, 20); ctxCam.fillText("RIGHT SENSOR", halfW + 12, 20);

    const cL = (halfW - 2) / 2, cR = halfW + 2 + (halfW - 2) / 2;
    ctxCam.fillStyle = d < 2 ? '#64748b' : '#10b981';
    ctxCam.beginPath(); ctxCam.arc(cL + (d/2), centerY, 15, 0, Math.PI*2); ctxCam.fill();
    ctxCam.beginPath(); ctxCam.arc(cR - (d/2), centerY, 15, 0, Math.PI*2); ctxCam.fill();
}

function animate(time) {
    requestAnimationFrame(animate);
    const wA = parseFloat(DOM.appCanvas.style.width) || DOM.appCanvas.width;
    const hA = parseFloat(DOM.appCanvas.style.height) || DOM.appCanvas.height;
    drawApparatus(wA, hA, time);

    const wC = parseFloat(DOM.camCanvas.style.width) || DOM.camCanvas.width;
    const hC = parseFloat(DOM.camCanvas.style.height) || DOM.camCanvas.height;
    drawCameraPOV(wC, hC, calcDisparity(S.f, S.B, S.Z));
}

// Wizard Logic
function gotoStep(stepIndex) {
    S.step = Math.min(Math.max(stepIndex, 0), 3);
    document.querySelectorAll('.step-node').forEach((node, idx) => {
        node.classList.toggle('active', idx === S.step);
    });
}

// Listeners
[DOM.b, DOM.f, DOM.z, DOM.s].forEach(input => input.addEventListener('input', updateState));
window.addEventListener('resize', resizeCanvases);

document.getElementById('btn-reset').addEventListener('click', () => {
    DOM.b.value = "10"; DOM.f.value = "700"; DOM.z.value = "2.0"; DOM.s.value = "0";
    updateState();
});

document.getElementById('btn-next').addEventListener('click', () => gotoStep(S.step + 1));
document.querySelectorAll('.step-node').forEach(dot => dot.addEventListener('click', () => gotoStep(parseInt(dot.dataset.step))));

document.addEventListener('DOMContentLoaded', () => {
    initChart(); resizeCanvases(); updateState(); requestAnimationFrame(animate); 
});
